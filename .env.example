# ===== 필수 설정 =====

# 디스코드 봇 토큰 (Discord Developer Portal → Your App → Bot → Token)
DISCORD_TOKEN=

# Anthropic API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# 인증 스크린샷을 올리는 채널 ID (채널 우클릭 → ID 복사)
VERIFICATION_CHANNEL_ID=

# 인증 완료 시 부여할 역할 ID (역할 우클릭 → ID 복사)
VERIFIED_ROLE_ID=

# ===== 선택 설정 =====

# 관리자 로그 채널 ID (비워두면 로그 비활성화)
LOG_CHANNEL_ID=

# 인증을 허용할 인스타그램 계정 아이디 (쉼표로 구분, 비워두면 전체 허용)
INSTAGRAM_ACCOUNTS=

# 스크린샷 시간과 메시지 전송 시간의 허용 오차 (분, 기본 15)
TOLERANCE_MINUTES=15

# 사용자 폰의 타임존 UTC 오프셋 (한국 KST = 9, 기본 9)
TIMEZONE_OFFSET=9
